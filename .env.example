# ───────── Server ─────────
PORT=3000

# ───────── Admin dashboard login (REQUIRED in production) ─────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ───────── Supabase (database) ─────────
# With these set, all settings/API keys you enter in the dashboard are saved in Supabase
# and restored automatically after every redeploy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ───────── Persistent storage (optional, recommended) ─────────
# Path of a persistent volume, e.g. /data on Railway
# DATA_DIR=/data

# Load demo conversations (testing only)
# SEED_DEMO=true

# On Railway you do NOT need DATA_DIR: when you attach a Volume, the app uses it
# automatically (RAILWAY_VOLUME_MOUNT_PATH), and RAILWAY_PUBLIC_DOMAIN for links.
